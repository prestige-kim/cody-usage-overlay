<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.proudchris.cody-usage-overlay</string>
  <key>ProgramArguments</key><array><string>__APP_PATH__/Contents/MacOS/CodyUsageOverlay</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/stdout.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/stderr.log</string>
</dict></plist>
