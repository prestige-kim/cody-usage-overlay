<Window x:Class="CodyUsageOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="242" Height="62" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual">
  <Border CornerRadius="15" Background="#E6161616" BorderBrush="#35FFFFFF" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
      <Button x:Name="CloseButton" Content="×" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="7,7,0,0" Padding="0" FontSize="14" FontWeight="SemiBold" Foreground="#CCFFFFFF"
              Background="#35FFFFFF" BorderThickness="0" Cursor="Hand" Click="CloseOverlay"/>
      <StackPanel Grid.Column="0" Margin="27,7,0,5">
        <TextBlock x:Name="LimitsText" Text="Week —" FontSize="16" FontWeight="Bold" Foreground="#7DA4FF"/>
        <TextBlock x:Name="ContextText" Text="Context —" Margin="0,6,0,0" FontSize="11" FontWeight="Medium" Foreground="#C7FFFFFF"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="Assets/codex-emoji.png" Width="36" Height="36" Stretch="Uniform"/>
        <TextBlock Text="🧑🏻‍💻" FontFamily="Segoe UI Emoji" FontSize="29" Margin="3,-2,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
