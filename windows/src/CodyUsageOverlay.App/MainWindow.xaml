<Window x:Class="CodyUsageOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="242" Height="62" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual">
  <Border CornerRadius="15" Background="#E6161616" BorderBrush="#35FFFFFF" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
      <Canvas x:Name="CodyGlobalFluidCanvas" Grid.ColumnSpan="2" Width="240" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True">
        <Ellipse x:Name="CodyGlobalBlobOne" Width="220" Height="82" Canvas.Left="10" Canvas.Top="-11" Opacity="0.03">
          <Ellipse.Effect><BlurEffect Radius="24"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="CodyGlobalBlobTwo" Width="174" Height="96" Canvas.Left="33" Canvas.Top="-18" Opacity="0.02">
          <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="CodyGlobalBlobThree" Width="204" Height="66" Canvas.Left="18" Canvas.Top="-3" Opacity="0.02">
          <Ellipse.Effect><BlurEffect Radius="20"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="CodyGlobalRipple" Width="48" Height="34" Canvas.Left="96" Canvas.Top="13" Opacity="0">
          <Ellipse.Effect><BlurEffect Radius="20"/></Ellipse.Effect>
        </Ellipse>
      </Canvas>
      <Canvas x:Name="AgentPulseBackgroundCanvas" Grid.ColumnSpan="2" Width="240" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True">
        <Ellipse x:Name="AgentPulseBackgroundBlobOne" Width="152" Height="62" Canvas.Left="66" Canvas.Top="-1" Fill="#FFFFFFFF" Opacity="0.018">
          <Ellipse.Effect><BlurEffect Radius="22"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AgentPulseBackgroundBlobTwo" Width="130" Height="70" Canvas.Left="80" Canvas.Top="-5" Fill="#FFFFFFFF" Opacity="0.014">
          <Ellipse.Effect><BlurEffect Radius="20"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AgentPulseBackgroundBlobThree" Width="112" Height="54" Canvas.Left="91" Canvas.Top="3" Fill="#FFFFFFFF" Opacity="0.011">
          <Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AgentPulseBackgroundBloom" Width="56" Height="32" Canvas.Left="114" Canvas.Top="14" Fill="#FFFFFFFF" Opacity="0">
          <Ellipse.Effect><BlurEffect Radius="20"/></Ellipse.Effect>
        </Ellipse>
      </Canvas>
      <Button x:Name="CloseButton" Content="×" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="7,7,0,0" Padding="0" FontSize="14" FontWeight="SemiBold" Foreground="#CCFFFFFF"
              Background="#35FFFFFF" BorderThickness="0" Cursor="Hand" Click="CloseOverlay"/>
      <Button x:Name="TimerButton" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="7,0,0,7" Padding="0" Foreground="#CCFFFFFF" Background="#23FFFFFF"
              BorderThickness="0" Cursor="Hand" ToolTip="리셋 타이머 보기" Click="ToggleResetCountdown">
        <Grid Width="11" Height="11" IsHitTestVisible="False" UseLayoutRounding="True">
          <Ellipse Stroke="#E6FFFFFF" StrokeThickness="1.2"/>
          <Line X1="5.5" Y1="5.5" X2="5.5" Y2="2.7" Stroke="#E6FFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Line X1="5.5" Y1="5.5" X2="8" Y2="6.8" Stroke="#E6FFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>
      </Button>
      <StackPanel x:Name="UsageReadout" Grid.Column="0" Margin="38,7,0,5">
        <TextBlock x:Name="LimitsText" Text="Week —" TextAlignment="Center" TextWrapping="NoWrap" FontSize="16" FontWeight="Bold" Foreground="#7DA4FF"/>
        <TextBlock x:Name="ContextText" Text="Context —" TextAlignment="Center" TextWrapping="NoWrap" Margin="0,6,0,0" FontSize="11" FontWeight="Medium" Foreground="#C7FFFFFF"/>
      </StackPanel>
      <StackPanel x:Name="CodyStateReadout" Grid.Column="0" Margin="38,7,0,5" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock Text="Cody State" TextAlignment="Center" FontSize="9" FontWeight="Medium" Foreground="#85FFFFFF"/>
        <TextBlock x:Name="CodyStateLabelText" Text="준비됨" TextAlignment="Center" Margin="0,6,0,0" FontSize="14" FontWeight="Bold" Foreground="White"/>
      </StackPanel>
      <StackPanel x:Name="AgentPulseReadout" Grid.Column="0" Margin="38,7,0,5" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock Text="Agent Pulse" TextAlignment="Center" FontSize="9" FontWeight="Medium" Foreground="#85FFFFFF"/>
        <TextBlock x:Name="AgentPulseLabelText" Text="활발 · 안정적인 진행" TextAlignment="Center" Margin="0,7,0,0" FontSize="10.5" FontWeight="Bold" Foreground="#35EBFF"/>
      </StackPanel>
      <Grid x:Name="AgentPulseIndicator" Grid.ColumnSpan="2" Width="38" Height="54" Margin="146,0,0,0"
            HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"
            ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="10000"
            MouseEnter="ShowAgentPulseLabel" MouseLeave="HideAgentPulseLabel"/>
      <Grid x:Name="CodyStateIndicator" Grid.Column="1" Width="50" Height="50" Margin="0,0,8,0"
            VerticalAlignment="Center" HorizontalAlignment="Right" Cursor="Hand" ClipToBounds="True"
              ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="10000"
              MouseEnter="ShowCodyStateLabel" MouseLeave="HideCodyStateLabel">
          <Canvas x:Name="CodyFluidCanvas" Width="50" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="CodyFluidBlobOne" Width="44" Height="36" Canvas.Left="3" Canvas.Top="6" Opacity="0.12">
              <Ellipse.Effect><BlurEffect Radius="6"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="CodyFluidBlobTwo" Width="34" Height="42" Canvas.Left="8" Canvas.Top="3" Opacity="0.1">
              <Ellipse.Effect><BlurEffect Radius="5"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="CodyFluidBlobThree" Width="39" Height="30" Canvas.Left="5" Canvas.Top="9" Opacity="0.08">
              <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="CodyFluidRipple" Width="24" Height="22" Canvas.Left="13" Canvas.Top="13" Opacity="0">
              <Ellipse.Effect><BlurEffect Radius="7"/></Ellipse.Effect>
            </Ellipse>
          </Canvas>
          <Image Source="Assets/codex-emoji.png" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
